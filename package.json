{
  "name": "vocabulary-games",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicativo de vocabulário em inglês (imagem, digitação e escrita) para Android e web",
  "scripts": {
    "dev": "http-server www -p 5173 -c-1 -o",
    "sync": "cap sync android",
    "android:add": "cap add android",
    "android:open": "cap open android",
    "assets": "capacitor-assets generate --android --assetPath assets",
    "apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/share": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.1",
    "http-server": "^14.1.1"
  }
}
